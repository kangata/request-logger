{
    "name": "quetzal-studio/request-logger",
    "description": "Request logger for laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Ata",
            "email": "quetzalskeith@gmail.com"
        }
    ],
    "require": {
        "php": "^7.4|^8.0"
    },
    "autoload": {
        "psr-4": {
            "QuetzalStudio\\RequestLogger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "QuetzalStudio\\RequestLogger\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "QuetzalStudio\\RequestLogger\\RequestLoggerServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^4.0|^5.0|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0"
    }
}
